# Copy to .env if you like, or set these in your shell. All values are optional.
# This project reads plain environment variables (no .env loader is installed),
# so in PowerShell, for example:  $env:EVIDENCEGUARD_TOP_K = "4"
# Never put secrets in this file; none are needed.

# Folder with the .md / .txt documents to index
EVIDENCEGUARD_DATA_DIR=data/raw
# Where the ChromaDB index for the API/CLI is stored (generated, not committed)
EVIDENCEGUARD_DB_PATH=chroma_db/app

# Local language model and numeric precision (float32 or bfloat16)
EVIDENCEGUARD_LLM_NAME=Qwen/Qwen2.5-0.5B-Instruct
EVIDENCEGUARD_LLM_DTYPE=bfloat16

# Retrieval and agent behaviour
EVIDENCEGUARD_TOP_K=3
EVIDENCEGUARD_WIDEN_K=5
EVIDENCEGUARD_MAX_ATTEMPTS=3
EVIDENCEGUARD_MAX_NEW_TOKENS=150
# Widen retrieval and retry after an abstention (off by default; measure before enabling)
EVIDENCEGUARD_RETRY_ON_ABSTAIN=false
# Only retry an abstention when the best retrieval score is at least this (not tuned)
EVIDENCEGUARD_MIN_RETRY_SCORE=0.35